    {
        "id": "ar-1282",
        "prompt": "\u0628\u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u060c \u0645\u0647\u0645\u062a\u0643 \u0647\u064a \u0627\u0644\u062d\u0643\u0645 \u0639\u0644\u0649 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d\u064b\u0627 \u0623\u0648 \u062e\u0627\u0637\u0626\u064b\u0627 \u0623\u0648 \u063a\u064a\u0631 \u0645\u062d\u062f\u062f \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u0636\u0645\u064a\u0646 \u0623\u0648 \u0627\u0644\u062a\u0646\u0627\u0642\u0636 \u0623\u0648 \u0627\u0644\u062d\u064a\u0627\u062f.\nPremise: \u0628\u0634\u0643\u0644 \u062d\u062f\u0633\u064a \u060c \u064a\u0628\u062f\u0648 \u0645\u0646 \u063a\u064a\u0631 \u0627\u0644\u0645\u062d\u062a\u0645\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0645\u062b\u0644 \u0647\u0630\u0627 \u0627\u0644\u0643\u0648\u0643\u0628 \u0645\u0646 \u0627\u0644\u0643\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0639\u0642\u062f\u0629 \u063a\u064a\u0631 \u0627\u0644\u062d\u064a\u0629 \u0642\u062f \u0646\u0634\u0623 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u0645\u0646\u0630 \u0627\u0644\u0627\u0646\u0641\u062c\u0627\u0631 \u0627\u0644\u0623\u0639\u0638\u0645.\nHypothesis: \u0647\u0648 \u064a\u0628\u062f\u0648 \u0645\u062b\u0644 \u063a\u064a\u0631 \u0627\u0644\u062d\u064a\u0629 \u0630\u0627\u062a\u064a\u0629 \u0644\u064a\u0633 \u0647\u0646\u0627 \u0645\u0635\u0627\u062f\u0641\u0629.\n\u062f\u0639\u0646\u0627 \u0646\u0641\u0643\u0631 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.\n\u064a\u062c\u0628 \u0623\u0646 \u062a\u0642\u062f\u0645 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642: '\u0627\u0644\u0639\u0644\u0627\u0642\u0629: [\u0627\u0633\u062a\u0644\u0632\u0627\u0645\u060c \u062d\u064a\u0627\u062f\u064a \u0623\u0648 \u062a\u0646\u0627\u0642\u0636]'.",
        "response": "\u0644\u062a\u0635\u0641\u062d \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629:\n\n1.  \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0627\u0644\u0645\u0642\u062f\u0645\u0629: \u062a\u0642\u0648\u0644 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0625\u0646 \u0627\u0644\u0643\u0648\u0643\u0628 \u064a\u0628\u062f\u0648 \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0646\u0634\u0623 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u0645\u0646\u0630 \u0627\u0644\u0627\u0646\u0641\u062c\u0627\u0631 \u0627\u0644\u0623\u0639\u0638\u0645.\n2.  \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636: \u064a\u0642\u0648\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0625\u0646 \u0627\u0644\u0643\u0648\u0643\u0628 \u064a\u0628\u062f\u0648 \u0645\u062b\u0644 \u063a\u064a\u0631 \u0627\u0644\u062d\u064a\u0629 \u0630\u0627\u062a\u064a\u0629 \u0644\u064a\u0633 \u0647\u0646\u0627 \u0645\u0635\u0627\u062f\u0641\u0629.\n3.  \u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636: \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062d\u0627\u0644\u0629\u060c \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0634\u0623\u0629 \u0627\u0644\u0643\u0648\u0643\u0628 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u064f\u0638\u0647\u0631 \u0623\u0646 \u0627\u0644\u0643\u0648\u0643\u0628 \u064a\u0628\u062f\u0648 \u0630\u0627\u062a\u064a\u064b\u0627 \u0645\u062b\u0644 \u063a\u064a\u0631 \u0627\u0644\u062d\u064a\u0629.\n4.  \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0639\u0644\u0627\u0642\u0629: \u064a\u0628\u062f\u0648 \u0623\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0634\u0623\u0629 \u0627\u0644\u0643\u0648\u0643\u0628 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u064f\u0638\u0647\u0631 \u0623\u0646 \u0627\u0644\u0643\u0648\u0643\u0628 \u064a\u0628\u062f\u0648 \u0630\u0627\u062a\u064a\u064b\u0627. \u0647\u0630\u0627 \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u064f\u0633\u062a\u0644\u0632\u0645 \u0645\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u062d\u064a\u062b \u0623\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0634\u0623\u0629 \u0627\u0644\u0643\u0648\u0643\u0628 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644\u0629\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0643\u062b\u0631 \u0627\u062d\u062a\u0645",
        "predicted_answer": "\u064a\u0628\u062f\u0648 \u0623\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0634\u0623\u0629 \u0627\u0644\u0643\u0648\u0643\u0628 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u064f\u0638\u0647\u0631 \u0623\u0646 \u0627\u0644\u0643\u0648\u0643\u0628 \u064a\u0628\u062f\u0648 \u0630\u0627\u062a\u064a\u064b\u0627 \u0647\u0630\u0627 \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u064f\u0633\u062a\u0644\u0632\u0645 \u0645\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u062d\u064a\u062b \u0623\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0646\u0634\u0623\u0629 \u0627\u0644\u0643\u0648\u0643\u0628 \u0628\u0634\u0643\u0644 \u0639\u0641\u0648\u064a \u063a\u064a\u0631 \u0645\u062d\u062a\u0645\u0644\u0629\u060c \u0645\u0645\u0627 \u064a\u062c\u0639\u0644 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0623\u0643\u062b\u0631 \u0627\u062d\u062a\u0645",
        "ground_truth": 0,
        "is_correct": false
    },
    {
        "id": "ar-1018",
        "prompt": "\u0628\u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u060c \u0645\u0647\u0645\u062a\u0643 \u0647\u064a \u0627\u0644\u062d\u0643\u0645 \u0639\u0644\u0649 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d\u064b\u0627 \u0623\u0648 \u062e\u0627\u0637\u0626\u064b\u0627 \u0623\u0648 \u063a\u064a\u0631 \u0645\u062d\u062f\u062f \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u0636\u0645\u064a\u0646 \u0623\u0648 \u0627\u0644\u062a\u0646\u0627\u0642\u0636 \u0623\u0648 \u0627\u0644\u062d\u064a\u0627\u062f.\nPremise: \u0628\u0647\u0630\u0647 \u0627\u0644\u0642\u0641\u0632\u0629 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0628\u0644\u0648\u0631\u0629 \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u062a\u0634\u0641\u064a\u0631 \u0642\u062f\u0631 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\nHypothesis: \u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u0641\u064a\u062f\u0629 \u062c\u062f\u0627 \u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\n\u062f\u0639\u0646\u0627 \u0646\u0641\u0643\u0631 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.\n\u064a\u062c\u0628 \u0623\u0646 \u062a\u0642\u062f\u0645 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642: '\u0627\u0644\u0639\u0644\u0627\u0642\u0629: [\u0627\u0633\u062a\u0644\u0632\u0627\u0645\u060c \u062d\u064a\u0627\u062f\u064a \u0623\u0648 \u062a\u0646\u0627\u0642\u0636]'.",
        "response": "\u0646\u062d\u0644\u0644 \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u0623\u0648\u0644\u0649: \n- \u0627\u0644\u0645\u0642\u062f\u0645\u0629: \"\u0628\u0647\u0630\u0647 \u0627\u0644\u0642\u0641\u0632\u0629 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0628\u0644\u0648\u0631\u0629 \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u062a\u0634\u0641\u064a\u0631 \u0642\u062f\u0631 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\"\n- \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636: \"\u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u0641\u064a\u062f\u0629 \u062c\u062f\u0627 \u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\"\n\n\u0641\u064a \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u064a\u0645\u0643\u0646\u0646\u0627 \u0623\u0646 \u0646\u0631\u0649 \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u0631\u062a\u0628\u0637 \u0628\u0634\u0643\u0644 \u0648\u062b\u064a\u0642 \u0628\u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u0631\u062d \u0633\u0628\u0628 \u0639\u062f\u0645 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0641\u064a \u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u0648\u0628\u0627\u0644\u062a\u0627\u0644\u064a \u064a\u0645\u0643\u0646\u0646\u0627 \u0623\u0646 \u0646\u0633\u062a\u0646\u062a\u062c \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d. \n\n\u0646\u062d\u0644\u0644 \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629:\n- \u0627\u0644\u0645\u0642\u062f\u0645\u0629: \"\u0628\u0647\u0630\u0647 \u0627\u0644\u0642\u0641\u0632\u0629 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0628\u0644\u0648\u0631\u0629 \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u062a\u0634\u0641\u064a\u0631 \u0642\u062f\u0631 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\"\n- \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636: \"\u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u0641\u064a\u062f\u0629 \u062c\u062f\u0627 \u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\"\n\n\u0641\u064a \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629\u060c \u064a\u0645\u0643\u0646\u0646\u0627 \u0623\u0646 \u0646\u0631\u0649 \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u0631\u062a\u0628\u0637 \u0628\u0634\u0643\u0644 \u0648\u062b\u064a\u0642 \u0628\u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u0631\u062d \u0633\u0628\u0628 \u0639\u062f\u0645 \u0643\u0641\u0627\u0621\u0629 \u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0641\u064a \u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u0648\u0628\u0627\u0644\u062a\u0627\u0644\u064a \u064a\u0645\u0643\u0646\u0646\u0627 \u0623\u0646 \u0646\u0633\u062a\u0646\u062a\u062c \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d.\n\n\u0646\u062d\u0644\u0644 \u0627\u0644\u062e\u0637\u0648\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629:\n- \u0627\u0644\u0645\u0642\u062f\u0645\u0629:",
