    {
        "id": "ar-1242",
        "prompt": "\u0628\u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u060c \u0645\u0647\u0645\u062a\u0643 \u0647\u064a \u0627\u0644\u062d\u0643\u0645 \u0639\u0644\u0649 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d\u064b\u0627 \u0623\u0648 \u062e\u0627\u0637\u0626\u064b\u0627 \u0623\u0648 \u063a\u064a\u0631 \u0645\u062d\u062f\u062f \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u0636\u0645\u064a\u0646 \u0623\u0648 \u0627\u0644\u062a\u0646\u0627\u0642\u0636 \u0623\u0648 \u0627\u0644\u062d\u064a\u0627\u062f.\nPremise: \u0648\u0628\u0627\u0644\u0637\u0628\u0639\u060c \u0641\u0625\u0646 \u0627\u0644\u0622\u062b\u0627\u0631 \u0627\u0644\u0639\u0638\u064a\u0645\u0629 \u0644\u0641\u0647\u0645 \u0627\u0644\u062d\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062b\u0627\u0645\u0646 \u0639\u0634\u0631 \u0647\u064a \u0627\u0644\u062f\u0633\u062a\u0648\u0631 \u0648\u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u062d\u0642\u0648\u0642.\nHypothesis: \u0644\u0645 \u064a\u0641\u0647\u0645 \u0623\u062d\u062f \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062b\u0627\u0645\u0646 \u0639\u0634\u0631 \u0627\u0644\u062d\u0631\u064a\u0629.\n\u062f\u0639\u0646\u0627 \u0646\u0641\u0643\u0631 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.\n\u064a\u062c\u0628 \u0623\u0646 \u062a\u0642\u062f\u0645 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642: '\u0627\u0644\u063