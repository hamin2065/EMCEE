        "prompt": "\u0628\u0627\u0644\u0646\u0638\u0631 \u0625\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u060c \u0645\u0647\u0645\u062a\u0643 \u0647\u064a \u0627\u0644\u062d\u0643\u0645 \u0639\u0644\u0649 \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0635\u062d\u064a\u062d\u064b\u0627 \u0623\u0648 \u062e\u0627\u0637\u0626\u064b\u0627 \u0623\u0648 \u063a\u064a\u0631 \u0645\u062d\u062f\u062f \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0627\u0644\u0645\u0642\u062f\u0645\u0629. \u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u062a\u0636\u0645\u064a\u0646 \u0623\u0648 \u0627\u0644\u062a\u0646\u0627\u0642\u0636 \u0623\u0648 \u0627\u0644\u062d\u064a\u0627\u062f.\nPremise: \u0648\u0627\u0641\u062a\u0631\u0636 \u062f\u0648\u0646 \u0645\u0628\u0631\u0631 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629 ...\nHypothesis: \u0648\u064a\u0641\u062a\u0631\u0636 \u0645\u0639 \u0648\u062c\u0648\u062f \u0633\u0628\u0628 \u0648\u062c\u064a\u0647 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629 ...\n\u062f\u0639\u0646\u0627 \u0646\u0641\u0643\u0631 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0639\u0631\u0628\u064a\u0629.\n\u064a\u062c\u0628 \u0623\u0646 \u062a\u0642\u062f\u0645 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0641\u064a \u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642: '\u0627\u0644\u0639\u0644\u0627\u0642\u0629: [\u0627\u0633\u062a\u0644\u0632\u0627\u0645\u060c \u062d\u064a\u0627\u062f\u064a \u0623\u0648 \u062a\u0646\u0627\u0642\u0636]'.",
        "response": "\u0644\u0642\u062f \u0642\u0645\u062a \u0628\u0641\u0647\u0645 \u0645\u0647\u0645\u062a\u0643. \u062f\u0639\u0646\u0627 \u0646\u062f\u0631\u0633 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u0627\u0644\u0641\u0631\u0636\u064a\u0629 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629.\n\n\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636: \u0648\u0627\u0641\u062a\u0631\u0636 \u062f\u0648\u0646 \u0645\u0628\u0631\u0631 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629...\n\u0647\u0630\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u0638\u0647\u0631 \u0623\u0646 \u0627\u0644\u0634\u062e\u0635 \u064a\u0641\u062a\u0631\u0636 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629... \u062f\u0648\u0646 \u0648\u062c\u0648\u062f \u0623\u064a \u0633\u0628\u0628 \u0623\u0648 \u062f\u0644\u064a\u0644. \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0627\u0644\u0634\u062e\u0635 \u0644\u0627 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0623\u064a \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0623\u0648 \u0623\u0633\u0627\u0633 \u0645\u0646\u0637\u0642\u064a \u0644\u0635\u062d\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636.\n\n\u0627\u0644\u0641\u0631\u0636\u064a\u0629: \u0648\u064a\u0641\u062a\u0631\u0636 \u0645\u0639 \u0648\u062c\u0648\u062f \u0633\u0628\u0628 \u0648\u062c\u064a\u0647 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629...\n\u0647\u0630\u0647 \u0627\u0644\u0641\u0631\u0636\u064a\u0629 \u062a\u0642\u0648\u0644 \u0625\u0646 \u0627\u0644\u0634\u062e\u0635 \u064a\u0641\u062a\u0631\u0636 \u0623\u0646 \u0627\u0644\u064a\u062f\u064a\u0634\u064a\u0629... \u0645\u0639 \u0648\u062c\u0648\u062f \u0633\u0628\u0628 \u0623\u0648 \u062f\u0644\u064a\u0644 \u0645\u0639\u064a\u0646. \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0627\u0644\u0634\u062e\u0635 \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0623\u0648 \u0623\u0633\u0627\u0633 \u0645\u0646\u0637\u0642\u064a \u0644\u0635\u062d\u0629 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636.\n\n\u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0647\u0630\u0627\u060c \u064a\u0645\u0643\u0646\u0646\u0627 \u0627\u0644\u0642\u0648\u0644 \u0623\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0648\u0627\u0644\u0641\u0631\u0636\u064a\u0629 \u0645\u062a\u0636\u0627\u062f\u0627\u0646. \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u0641\u062a\u0631\u0636 \u062f\u0648\u0646 \u0645\u0628\u0631\u0631\u060c \u0641\u064a \u062d\u064a\u0646 \u0623\u0646 \u0627\u0644\u0641\u0631\u0636\u064a\u0629 \u064a\u0641\u062a\u0631\u0636 \u0645\u0639 \u0648\u062c\u0648\u062f \u0633\u0628\u0628 \u0648\u062c\u064a\u0647.\n\n\u0644\u0630\u0644\u0643\u060c \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0647\u064a:\n\u0627\u0644\u0639\u0644\u0627\u0642\u0629: \u062a\u0646\u0627\u0642\u0636.",
        "predicted_answer": 2,
