        "response": "\u0644\u0646\u0628\u062f\u0623 \u0628\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636.\n\n\u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0623\u0646 \u0647\u0646\u0627\u0643 \"\u0622\u062b\u0627\u0631 \u0639\u0638\u064a\u0645\u0629 \u0644\u0641\u0647\u0645 \u0627\u0644\u062d\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062b\u0627\u0645\u0646 \u0639\u0634\u0631\"\u060c \u0648\u062a\u062d\u062f\u064a\u062f\u064b\u0627 \u062a\u0630\u0643\u0631 \u0627\u0644\u062f\u0633\u062a\u0648\u0631 \u0648\u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u062d\u0642\u0648\u0642 \u0643\u0623\u0645\u062b\u0644\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0622\u062b\u0627\u0631. \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0647\u0646\u0627\u0643 \u0641\u0647\u0645\u064b\u0627 \u0644\u0644\u062d\u0631\u064a\u0629 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0648\u0642\u062a\u060c \u0648\u0623\u0646 \u0647\u0630\u0627 \u0627\u0644\u0641\u0647\u0645 \u0623\u062f\u0649 \u0625\u0644\u0649 \u0646\u062a\u0627\u0626\u062c \u0645\u0644\u0645\u0648\u0633\u0629.\n\n\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u0642\u0648\u0644: \"\u0644\u0645 \u064a\u0641\u0647\u0645 \u0623\u062d\u062f \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062b\u0627\u0645\u0646 \u0639\u0634\u0631 \u0627\u0644\u062d\u0631\u064a\u0629\". \u0647\u0630\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u062a\u0646\u0627\u0642\u0636 \u0645\u0639 \u0645\u0627 \u062a\u0645 \u0630\u0643\u0631\u0647 \u0641\u064a \u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u062d\u064a\u062b \u0623\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0648\u0636\u062d \u0623\u0646 \u0647\u0646\u0627\u0643 \u0641\u0647\u0645\u064b\u0627 \u0644\u0644\u062d\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0642\u0631\u0646 \u0627\u0644\u062b\u0627\u0645\u0646 \u0639\u0634\u0631\u060c \u0648\u0628\u0627\u0644\u062a\u0627\u0644\u064a \u0641\u0625\u0646 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d.\n\n\u0644\u0630\u0627\u060c \u0646\u0633\u062a\u0646\u062a\u062c \u0623\u0646 \u0627\u0644\u0639\u0644\u0627\u0642\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0647\u064a \u0639\u0644\u0627\u0642\u0629 \u062a\u0646\u0627\u0642\u0636.\n\n\u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0646\u0647\u0627\u0626\u064a\u0629 \u0647\u064a: \u0627\u0644\u0639\u0644\u0627\u0642\u0629: [\u062a\u0646\u0627\u0642\u0636]",
