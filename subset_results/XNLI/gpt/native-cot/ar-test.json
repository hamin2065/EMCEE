        "response": "\u0644\u0646\u0628\u062f\u0623 \u0628\u062a\u062d\u0644\u064a\u0644 \u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u0648\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636.\n\n\u0627\u0644\u0645\u0642\u062f\u0645\u0629 \u062a\u0642\u0648\u0644: \"\u0628\u0647\u0630\u0647 \u0627\u0644\u0642\u0641\u0632\u0629 \u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0644\u0628\u0644\u0648\u0631\u0629 \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u062a\u0634\u0641\u064a\u0631 \u0642\u062f\u0631 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\" \u0647\u0630\u0627 \u064a\u0639\u0646\u064a \u0623\u0646 \u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u0647\u0627 \u0642\u064a\u0648\u062f \u0641\u064a \u0642\u062f\u0631\u062a\u0647\u0627 \u0639\u0644\u0649 \u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u0648\u0628\u0627\u0644\u062a\u0627\u0644\u064a \u0641\u0647\u064a \u0644\u064a\u0633\u062a \u0641\u0639\u0627\u0644\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0633\u064a\u0627\u0642.\n\n\u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u0647\u0648: \"\u0627\u0644\u0628\u0644\u0648\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u0645\u0641\u064a\u062f\u0629 \u062c\u062f\u0627 \u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a.\" \u0647\u0630\u0627 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636 \u064a\u062a\u0645\u0627\u0634\u0649 \u0645\u0639 \u0645\u0627 \u062a\u0645 \u0630\u0643\u0631\u0647 \u0641\u064a \u0627\u0644\u0645\u0642\u062f\u0645\u0629\u060c \u062d\u064a\u062b \u0623\u0646 \u0639\u062f\u0645 \u0627\u0644\u0642\u062f\u0631\u0629 \u0639\u0644\u0649 \u062a\u0634\u0641\u064a\u0631 \u0642\u062f\u0631 \u0643\u0628\u064a\u0631 \u0645\u0646 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u0